# syntax=docker/dockerfile:1.7
#
# HelpDesk At-Once-AI — deploy UI (servicio Easypanel `trudesk`)
# Build File en Easypanel: Dockerfile.ui
# Requiere imagen: ghcr.io/mcandiav/trudesk-custom-base:latest (Public)
# Runbook: docs/ops-easypanel-rebuild.md

ARG BASE_IMAGE=ghcr.io/mcandiav/trudesk-custom-base:latest
FROM ${BASE_IMAGE}

WORKDIR /usr/src/trudesk

ARG GIT_SHA=
ENV TD_GIT_COMMIT=$GIT_SHA

COPY public/css/atonce-branding.css ./public/css/atonce-branding.css
COPY public/img/ ./public/img/
COPY public/atonce/ ./public/atonce/
COPY src/views/ ./src/views/
COPY src/mailer/templates/ ./src/mailer/templates/
COPY VERSION ./

RUN if [ -n "$GIT_SHA" ]; then printf '%.7s\n' "$GIT_SHA" > .git-commit; \
    elif [ -f .git-commit ]; then true; \
    else echo unknown > .git-commit; fi

EXPOSE 8118

CMD ["/bin/bash", "/usr/src/trudesk/startup.sh"]
