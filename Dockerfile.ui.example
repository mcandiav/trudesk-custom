# HelpDesk At-Once-AI — capa UI (look & feel)
# Uso FUTURO: servicio `trudesk` cuando ya exista imagen base publicada.
# Hoy el servicio `trudesk` sigue usando `Dockerfile` (build completo) hasta
# completar el cableado base → UI.
#
# FROM debe apuntar a la imagen generada por el servicio `trudesk-base`
# (o a ghcr.io/OWNER/trudesk-custom-base:TAG cuando esté publicada).
#
# ARG BASE_IMAGE=ghcr.io/mcandiav/trudesk-custom-base:1.2.15
# FROM ${BASE_IMAGE}

FROM node:16.14-alpine
# Placeholder: no usar aún en Easypanel para el servicio de producción.
# Se activará en el siguiente paso del plan (conectar trudesk a la base).

WORKDIR /usr/src/trudesk
CMD ["true"]
