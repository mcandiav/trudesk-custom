<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <title>HelpDesk At-Once-AI · Account Recovery</title>
</head>
<body style="margin:0;background:#0f172a;color:#e2e8f0;font-family:Segoe UI,Helvetica,Arial,sans-serif;">
<div style="max-width:560px;margin:0 auto;padding:24px 16px;">
    <div style="background:#1e293b;border:1px solid #334155;border-radius:12px;padding:24px;">
        <p style="text-align:center;color:#67e8f9;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;">HelpDesk At-Once-AI</p>
        <p>Dear {{user.fullname}},</p>
        <p>Someone (or you) requested account recovery for your HelpDesk At-Once-AI account: <strong>{{user.username}}</strong>.</p>
        <p>Click the link below if you made this request.</p>
        <p style="text-align:center;">
            <a href="{{base_url}}/resetl2auth/{{user.resetL2AuthHash}}" style="display:inline-block;padding:12px 18px;border-radius:10px;background:linear-gradient(135deg,#26c6da,#1565c0);color:#eff6ff;text-decoration:none;font-weight:600;">Recover Account</a>
        </p>
    </div>
</div>
</body>
</html>
