<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Welcome to HelpDesk At-Once-AI</title>
</head>
<body style="margin:0;background:#0f172a;color:#e2e8f0;font-family:Segoe UI,Helvetica,Arial,sans-serif;">
<div style="max-width:560px;margin:0 auto;padding:24px 16px;">
    <div style="background:#1e293b;border:1px solid #334155;border-radius:12px;padding:24px;">
        <p style="text-align:center;color:#67e8f9;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;">HelpDesk At-Once-AI</p>
        <p>Dear {{fullname}},</p>
        <p>Welcome to HelpDesk At-Once-AI. Use the details below to sign in:</p>
        <p>
            <a href="{{baseUrl}}" style="color:#38bdf8;">{{baseUrl}}</a><br /><br />
            <strong>Username: {{username}}</strong><br />
            <strong>Password: {{plainTextPassword}}</strong>
        </p>
    </div>
</div>
</body>
</html>
