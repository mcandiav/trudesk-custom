<!DOCTYPE html>
<html>
<head>
    <title>{{{siteTitle}}} &middot; {{{title}}}</title>
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link rel="stylesheet" href="/css/plugins.min.css">
    <link rel="stylesheet" href="/css/app.min.css">
    <link rel="stylesheet" href="/css/atonce-branding.css">
    <style type="text/css">
        html {
            overflow-x: hidden;
            height: 100%;
        }
        body {
            background: #eee;
            text-align: center;
            font-family: "Roboto", Arial, sans-serif;
            height: 100%;
            -webkit-font-smoothing: subpixel-antialiased;
        }

        .wrapper,
        #privacyPolicySlide {
            width: 400px;
            height: auto;
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50.111%);
            -webkit-transform: translate(-50%, -50.111%);
            padding: 15px 0;
        }

        #privacyPolicySlide {
            width: 75%;
            text-align: left;
            height: auto;
        }

        .white-box {
            height: 500px;
            background: #f6f6f6;
            border: 1px solid #ccc;
            color: #222;
            padding: 15px;
            overflow: auto;
        }

        h2 {
            color: #444;
        }

        p {
            font-family: "Roboto", Arial, sans-serif;
            font-weight: 300;
            font-size: 16px;
            line-height: 24px;
            color: #272727;
            text-rendering: auto;
        }

        img {
            margin-bottom: 55px;
        }

        label {
            text-align: left
        }

        button:not('.action') {
            font-family: "Roboto", Arial, sans-serif;
            width: 340px;
            height: 20px;
            text-align: left;
            padding: 15px 20px;
            background: #384b5f;
            border: 1px solid #1c2937;
            font-size: 20px;
            color: #fff;
            margin-bottom: 15px;
            border-radius: 3px;
            -moz-border-radius: 3px;
            -webkit-border-radius: 3px;
            font-weight: 300;
        }

        button.button {
            width: 380px;
            height: auto;
            text-align: center;
            background: #e74b3b;
            border: none;
            text-transform: uppercase;
            border-radius: 3px;
            -moz-border-radius: 3px;
            -webkit-border-radius: 3px;
        }

        button.button:hover {
            background: #f15849;
            cursor: pointer;
        }

        *:focus {
            outline: 0;
        }

        a {
            display: inline-block;
            padding-right: 10px;
            color: #727272;
            font-size: 14px;
            float: right;
            text-decoration: none;
            font-weight: 300;
        }

        a:hover {
            color: #A5A5A5;
        }

        ::-webkit-input-placeholder { /* WebKit browsers */
            color:    #222;
        }
        :-moz-placeholder { /* Mozilla Firefox 4 to 18 */
            color:    #222;
            opacity:  1;
        }
        ::-moz-placeholder { /* Mozilla Firefox 19+ */
            color:    #222;
            opacity:  1;
        }
        :-ms-input-placeholder { /* Internet Explorer 10+ */
            color:    #222;
        }

        .alert-message p {
            margin-top: 8px;
            margin-bottom: 0;
            color: white;
            font-weight: 300;
            text-align: center;
        }

        button.button.noCap {
            text-transform: none;
        }

        .hide {
            display: none;
        }

        .green {
            background: #29b955;
        }

        .md-input-bar:before,
        .md-input-bar:after {
            background: #2196f3 !important;
        }

        .btn {
            width: 100%;
            height: 50px;
            margin-bottom: 24px !important;
            /*color: #E74C3C;*/
        }

        .btn:hover, .btn:active, .btn:focus {
            /*color: #222;*/
        }

        #logosvg {
            position: absolute;
            top: 35px;
            left: 35px;
        }

        .l1 {
            stroke-dasharray: 290;
            stroke-dashoffset: 290;
            animation: line 0.8s infinite ease-in-out;
            -webkit-animation: line 0.8s infinite ease-in-out;
        }

        @keyframes line {
            0% {
                stroke-dashoffset: 290;
            }
            50% {
                stroke-dashoffset: 0;
            }
            100% {
                stroke-dashoffset: -290;
            }
        }
        .loader {
            height: 75px;
            width: 100%;
        }
        .loader:before {
            content: '';
            padding-top: 50px !important;
        }
        .loader svg {
            position: relative;
            top: 50%;
            -webkit-transform: translateY(-50%);
            -ms-transform: translateY(-50%);
            transform: translateY(-50%);
        }
        .loader svg line {
            stroke: #000;
            stroke-width: 5;
            stroke-linecap: round;
        }
    </style>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/vendor.js"></script>
    <script src="/js/truRequire.js"></script>
    <script src="/js/newissue-i18n.js"></script>
</head>
<body class="atonce-public">
<div class="atonce-public-brand">
    <img src="{{pageLogo}}" alt="HelpDesk At-Once-AI" class="atonce-public-logo" />
    <p class="login-product">HelpDesk At-Once-AI</p>
    <p class="login-version">{{versionLabel}}</p>
    <div class="lang-picker" data-newissue-lang-picker aria-label="Idioma"></div>
</div>
<div class="wrapper">
    <div class="slides">
        <div class="slide">
            <h2 style="margin-bottom: 18px;" data-i18n="welcome.title">Nuevo ticket</h2>
            <p style="text-align: left;" data-i18n="welcome.lead">
                Este asistente te guiará para enviar un nuevo ticket de soporte.
            </p>
            <button class="btn md-btn md-btn-wave md-btn-success" data-next data-i18n="welcome.start">Comenzar</button>
        </div>

        <div id="userInfoSlide" class="slide hide">
            <h2 style="margin-bottom: 25px;" data-i18n="user.title">Tus datos</h2>
            <p style="text-align: left;" data-i18n="user.lead">
                Necesitamos saber cómo registrar tu solicitud. Indícanos un poco sobre ti.
            </p>
            <form id="userInfo" class="uk-form-stacked uk-clearfix">
                <div class="uk-margin-medium-bottom">
                    <label for="user-fullname" data-i18n="user.fullname">Nombre completo</label>
                    <input id="user-fullname" name="user-fullname" class="md-input" type="text" required />
                </div>
                <div class="uk-margin-medium-bottom">
                    <label for="user-email" data-i18n="user.email">Correo electrónico</label>
                    <input id="user-email" name="user-email" class="md-input" type="email" required />
                </div>
                <div class="uk-margin-medium-bottom">
                    <div id="captchaImage" style="margin-bottom: 10px;"></div>
                    <label for="captcha" data-i18n="user.captcha">Escribe las letras que ves arriba.</label>
                    <input id="captcha" name="captcha" class="md-input" type="text" required />
                </div>
                <div style="width: 25%; float: left;">
                    <button class="btn md-btn md-btn-wave md-btn-primary1" type="button" data-prev data-i18n="user.back">Atrás</button>
                </div>
                <div style="width: 70%; float: right;">
                    <button id="checkEmail" class="btn md-btn md-btn-wave md-btn-success" type="button" data-i18n="user.next">Siguiente</button>
                </div>
            </form>
            <a href="#" class="no-ajaxy" id="privacyPolicyBtn" data-i18n="user.privacy">Política de privacidad</a>
        </div>

        <div class="slide hide">
            <h2 style="margin-bottom: 25px;" data-i18n="issue.title">Ticket</h2>
            <p style="text-align: left; margin-bottom: 25px;" data-i18n="issue.lead">
                Cuéntanos el problema. Sé lo más detallado posible para resolverlo pronto.
            </p>
            <form id="adminAccount" class="uk-form-stacked uk-clearfix">
                <div class="uk-margin-medium-bottom">
                    <label for="ticket-subject" data-i18n="issue.subject">Asunto</label>
                    <input type="text" id="ticket-subject" name="ticket-subject" class="md-input" required />
                </div>
                <div class="uk-margin-medium-bottom">
                    <label for="ticket-issue" data-i18n="issue.body">Descripción</label>
                    <textarea name="ticket-issue" id="ticket-issue" cols="30" rows="10" class="md-input" required></textarea>
                </div>
                <div style="width: 25%; float: left;">
                    <button class="btn md-btn md-btn-wave md-btn-primary1" type="button" data-prev data-i18n="issue.back">Atrás</button>
                </div>
                <div style="width: 70%; float: right;">
                    <button class="btn md-btn md-btn-wave md-btn-success" type="button" id="submit-issue" data-i18n="issue.submit">Enviar ticket</button>
                </div>
            </form>
        </div>

        <div class="slide hide">
            <h2 style="margin-bottom: 25px;" data-i18n="creating.title">Creando ticket...</h2>
            <p style="text-align: left;" data-i18n="creating.lead">Gracias por enviar tu solicitud. Te enviamos un correo con los datos de acceso para ver y crear tickets en el futuro.</p>
            <div class="loader">
                <svg style="width: 140px;" viewBox="0 0 288.9 70.1">
                    <line class="l1" x1="0" y1="0" x2="288" y2="0"></line>
                </svg>
            </div>
        </div>

        <div id="restartSlide" class="slide hide">
            <h2 style="margin-bottom: 25px;" data-i18n="restart.title">Reinicio necesario</h2>
            <p style="text-align: left;" data-i18n="restart.lead">La aplicación debe reiniciarse. Reiníciala y deberías ver la pantalla de inicio de sesión.</p>
            <button class="btn md-btn md-btn-wave" type="button" id="restartTrudesk" data-i18n="restart.btn">Reiniciar</button>
        </div>

        <div id="errorSlide" class="slide hide">
            <h2 style="margin-bottom: 25px;" data-i18n="fatal.title">Algo salió mal</h2>
            <p style="text-align: justify;" data-i18n="fatal.lead">Hubo un problema inesperado. Puedes reintentar o volver a empezar.</p>
            <pre style="text-align: left; font-size: 11px; font-weight: normal; margin-bottom: 15px;"></pre>
            <div style="width: 100%;">
                <a href="https://www.github.com/polonel/trudesk/issues/new" target="_blank" style="width: 100%; padding: 0; margin: 0;">
                    <button class="btn md-btn md-btn-wave md-btn-danger" type="button" style="width: 100%; margin-bottom: 10px !important;" data-i18n="fatal.submit">Reportar el problema</button>
                </a>
                <button class="btn md-btn md-btn-wave md-btn-success" type="button" style="width: 100%; margin-bottom: 10px !important;" onclick="location.reload();" data-i18n="fatal.retry">Empezar de nuevo</button>
                <a href="https://github.com/polonel/trudesk/blob/master/README.md" target="_blank" style="width: 100%; padding: 0; margin: 0;">
                    <button class="btn md-btn md-btn-wave" type="button" style="width: 100%; margin-bottom: 10px !important;" data-i18n="fatal.docs">Ver documentación</button>
                </a>
            </div>
        </div>

        <div id="emailExistsSlide" class="slide hide">
            <h2 style="margin-bottom: 25px;" data-i18n="emailExists.title">El correo ya existe</h2>
            <p style="text-align: justify;" id="emailExistsLead">
                El correo <span id="emailSpan" style="font-weight: bold;">email@email.com</span> ya está registrado. Si ya tienes cuenta, inicia sesión y crea el ticket desde allí.
            </p>
            <div style="width: 100%; margin-top: 50px;">
                <a href="/login" class="no-ajaxy" style="width: 100%; padding: 0; margin: 0;">
                    <button class="btn md-btn md-btn-wave md-btn-primary" type="button" style="width: 100%; margin-bottom: 10px !important;" data-i18n="emailExists.login">Iniciar sesión</button>
                </a>
                <button class="btn md-btn md-btn-wave" type="button" style="width: 100%; margin-bottom: 10px !important;" onclick="location.reload();" data-i18n="emailExists.restart">Empezar de nuevo</button>
            </div>
        </div>

        <div id="ticketCreatedSlide" class="slide hide">
            <h2 style="margin-bottom: 25px; text-align: left;"><span data-i18n="created.thanks">Gracias</span> <span id="spanFullname" style="color: #2196f3;">[Fullname]</span>,</h2>
            <p style="text-align: justify;" id="createdLead">
                Tu ticket, <strong id="strongSubject">[Subject]</strong> fue enviado. Guarda la siguiente información para acceder y actualizarlo.
            </p>
            <p style="text-align: left;">
                <span data-i18n="created.username">Usuario</span>: <strong id="strongUsername">[Username]</strong> <br>
                <span data-i18n="created.password">Contraseña</span>: <strong id="strongPassword">[Password]</strong>
            </p>
            <p style="text-align: justify;" data-i18n="created.follow">
                Usa el enlace de abajo para iniciar sesión y ver el estado de este ticket.
            </p>
            <div style="width: 100%; margin-top: 50px;">
                <a href="/login" class="no-ajaxy" style="width: 100%; padding: 0; margin: 0;">
                    <button class="btn md-btn md-btn-wave md-btn-primary" type="button" style="width: 100%; margin-bottom: 10px !important;" data-i18n="created.login">Iniciar sesión</button>
                </a>
            </div>
        </div>
    </div>
</div>

<div id="privacyPolicySlide" class="hide">
    <div class="white-box" style="margin-bottom: 15px;">
        {{{data.privacyPolicy}}}
    </div>
    <button id="privacyPolicyBackBtn" class="btn md-btn md-btn-wave md-btn-primary" type="button" style="width: 100%; margin-bottom: 10px !important;" data-i18n="privacy.back">Atrás</button>
</div>

<script type="text/javascript">
    function ni18n(key, vars) {
        return (window.NewIssueI18n && window.NewIssueI18n.t) ? window.NewIssueI18n.t(key, vars) : key;
    }

    function refreshEmailExistsLead(email) {
        var lead = document.getElementById('emailExistsLead');
        if (!lead) return;
        var text = ni18n('emailExists.lead', { email: email || '' });
        lead.innerHTML = '';
        var parts = email ? text.split(email) : [text];
        if (parts.length === 2 && email) {
            lead.appendChild(document.createTextNode(parts[0]));
            var strong = document.createElement('span');
            strong.id = 'emailSpan';
            strong.style.fontWeight = 'bold';
            strong.textContent = email;
            lead.appendChild(strong);
            lead.appendChild(document.createTextNode(parts[1]));
        } else {
            lead.textContent = text;
        }
    }

    function refreshCreatedLead(subject) {
        var lead = document.getElementById('createdLead');
        if (!lead) return;
        var text = ni18n('created.lead', { subject: subject || '' });
        lead.innerHTML = '';
        var parts = subject ? text.split(subject) : [text];
        if (parts.length === 2 && subject) {
            lead.appendChild(document.createTextNode(parts[0]));
            var strong = document.createElement('strong');
            strong.id = 'strongSubject';
            strong.textContent = subject;
            lead.appendChild(strong);
            lead.appendChild(document.createTextNode(parts[1]));
        } else {
            lead.textContent = text;
        }
    }

    window.onNewIssueLangChange = function () {
        var emailEl = document.getElementById('emailSpan');
        if (emailEl && emailEl.textContent) refreshEmailExistsLead(emailEl.textContent);
        var subjectEl = document.getElementById('strongSubject');
        if (subjectEl && subjectEl.textContent && subjectEl.textContent !== '[Subject]') {
            refreshCreatedLead(subjectEl.textContent);
        }
    };

    window.truRequire(['jquery', 'snackbar', 'helpers'], function (loadedModules) {
        var $ = loadedModules[0];
        window.Snackbar = loadedModules[1];
        var helpers = loadedModules[2];

        $(document).ready(function () {
            if (window.NewIssueI18n) window.NewIssueI18n.mount();
            helpers.init();
            getCaptcha();
            var $slides = $('.slides > .slide');
            var totalSlides = 0;
            var activeSlide = 0;
            $slides.each(function (idx) {
                $(this).addClass('slide-' + idx);
                if (idx === 0) $(this).addClass('activeSlide');
                else $(this).addClass('hide');
                totalSlides++;
            });

            function getCaptcha() {
                $.ajax({
                    method: 'GET',
                    url: '/captcha',
                    success: function (response) {
                        var svg = $(response).find('svg');
                        $('#captchaImage').append(svg);
                    },
                    error: function (err) {
                        console.error(err);
                    }
                });
            }

            function isDoubleClicked(element) {
                if (element.data('isclicked')) return true;
                element.data('isclicked', true);
                setTimeout(function () {
                    element.removeData('isclicked');
                }, 1000);
                return false;
            }

            $('button[data-next]').click(function () {
                if (isDoubleClicked($(this))) return;
                advanceSlide();
            });

            $('button[data-prev]').click(function () {
                if (isDoubleClicked($(this))) return;
                var prevSlideIdx = activeSlide - 1;
                var prevSlide = $('.slide-' + prevSlideIdx);
                if (prevSlide.length > 0) {
                    $(this).parents('.slide').fadeOut(300, function () {
                        prevSlide.css({ display: 'none' }).removeClass('hide');
                        $(this).addClass('hide').removeClass('activeSlide');
                        prevSlide.fadeIn(300, function () {
                            prevSlide.addClass('activeSlide');
                        });
                    });
                    activeSlide--;
                }
            });

            var userInfo = undefined;
            var ticket = undefined;

            $('button#checkEmail').click(function () {
                if (isDoubleClicked($(this))) return;
                var userInfoFormData = $('form#userInfo').serializeObject();
                var $emailField, $fullnameField;
                var $emailValid = false, $fullnameValid = false;

                if (!userInfoFormData['user-email'] || !validateEmail(userInfoFormData['user-email'])) {
                    $emailField = $('form#userInfo').find('input#user-email');
                    $emailField.parent('.md-input-wrapper').addClass('has-error');
                    $emailField.parent('.md-input-wrapper').find('.md-input-bar').addClass('bottom-border error-color');
                    $emailField.addClass('uk-form-danger');
                } else {
                    $emailField = $('form#userInfo').find('input#user-email');
                    $emailField.parent('.md-input-wrapper').removeClass('has-error');
                    $emailField.parent('.md-input-wrapper').find('.md-input-bar').removeClass('bottom-border error-color');
                    $emailField.removeClass('uk-form-danger');
                    $emailValid = true;
                }

                if (!userInfoFormData['user-fullname'] || userInfoFormData['user-fullname'].length < 5) {
                    $fullnameField = $('form#userInfo').find('input#user-fullname');
                    $fullnameField.parent('.md-input-wrapper').addClass('has-error');
                    $fullnameField.parent('.md-input-wrapper').find('.md-input-bar').addClass('bottom-border error-color');
                    $fullnameField.addClass('uk-form-danger');
                } else {
                    $fullnameField = $('form#userInfo').find('input#user-fullname');
                    $fullnameField.parent('.md-input-wrapper').removeClass('has-error');
                    $fullnameField.parent('.md-input-wrapper').find('.md-input-bar').removeClass('bottom-border error-color');
                    $fullnameField.removeClass('uk-form-danger');
                    $fullnameValid = true;
                }

                if (!$fullnameValid || !$emailValid) return false;

                var $checkEmailBtn = $(this);
                $checkEmailBtn.prop('disabled', true).text(ni18n('user.validating'));
                $.ajax({
                    method: 'POST',
                    url: '/api/v1/public/users/checkemail',
                    data: {
                        email: userInfoFormData['user-email'],
                        captcha: $('#captcha').val()
                    },
                    error: function (e) {
                        $checkEmailBtn.prop('disabled', false).text(ni18n('user.next'));
                        window.Snackbar.show({
                            text: ni18n('error.captcha'),
                            actionTextColor: 'red'
                        });
                        console.error(e);
                    },
                    success: function (data) {
                        $checkEmailBtn.prop('disabled', false).text(ni18n('user.next'));
                        if (!data.success) {
                            window.Snackbar.show({
                                text: ni18n('error.generic'),
                                actionTextColor: 'red'
                            });
                        } else if (data.exist) {
                            var $active = $('.activeSlide');
                            var errorSlide = $('#emailExistsSlide');
                            if (errorSlide.length > 0) {
                                refreshEmailExistsLead(userInfoFormData['user-email']);
                                $active.fadeOut(300, function () {
                                    errorSlide.css({ display: 'none' }).removeClass('hide');
                                    $(this).addClass('hide').removeClass('activeSlide');
                                    errorSlide.fadeIn(300, function () {
                                        errorSlide.addClass('activeSlide');
                                    });
                                });
                                activeSlide++;
                            }
                        } else {
                            userInfo = {
                                fullname: userInfoFormData['user-fullname'],
                                email: userInfoFormData['user-email']
                            };
                            $emailField = $('form#userInfo').find('input#user-email');
                            $emailField.parent('.md-input-wrapper').removeClass('has-error');
                            $emailField.parent('.md-input-wrapper').find('.md-input-bar').removeClass('bottom-border error-color');
                            $emailField.removeClass('uk-form-danger');
                            $fullnameField = $('form#userInfo').find('input#user-fullname');
                            $fullnameField.parent('.md-input-wrapper').removeClass('has-error');
                            $fullnameField.parent('.md-input-wrapper').find('.md-input-bar').removeClass('bottom-border error-color');
                            $fullnameField.removeClass('uk-form-danger');
                            advanceSlide();
                        }
                    }
                });
            });

            function advanceSlide() {
                var $active = $('.activeSlide');
                var nextSlideIdx = activeSlide + 1;
                var nextSlide = $('.slide-' + nextSlideIdx);
                if (nextSlide.length > 0) {
                    $active.fadeOut(300, function () {
                        $(this).addClass('hide').removeClass('activeSlide');
                        nextSlide.css({ display: 'none' }).removeClass('hide');
                        nextSlide.fadeIn(300, function () {
                            nextSlide.addClass('activeSlide');
                        });
                    });
                    activeSlide++;
                }
            }

            $('button#submit-issue').click(function () {
                if (isDoubleClicked($(this))) return;
                var adminInfoFormData = $('form#adminAccount').serializeObject();
                var $subjectField, $issueField;
                var $subjectValid = false, $issueValid = false;

                if (!adminInfoFormData['ticket-subject'] || adminInfoFormData['ticket-subject'].length < 5) {
                    $subjectField = $('form#adminAccount').find('input#ticket-subject');
                    $subjectField.parent('.md-input-wrapper').addClass('has-error');
                    $subjectField.parent('.md-input-wrapper').find('.md-input-bar').addClass('bottom-border error-color');
                    $subjectField.addClass('uk-form-danger');
                } else {
                    $subjectField = $('form#adminAccount').find('input#ticket-subject');
                    $subjectField.parent('.md-input-wrapper').removeClass('has-error');
                    $subjectField.parent('.md-input-wrapper').find('.md-input-bar').removeClass('bottom-border error-color');
                    $subjectField.removeClass('uk-form-danger');
                    $subjectValid = true;
                }

                if (!adminInfoFormData['ticket-issue'] || adminInfoFormData['ticket-issue'].length < 10) {
                    $issueField = $('form#adminAccount').find('textarea#ticket-issue');
                    $issueField.parent('.md-input-wrapper').addClass('has-error');
                    $issueField.parent('.md-input-wrapper').find('.md-input-bar').addClass('bottom-border error-color');
                    $issueField.addClass('uk-form-danger');
                } else {
                    $issueField = $('form#adminAccount').find('textarea#ticket-issue');
                    $issueField.parent('.md-input-wrapper').removeClass('has-error');
                    $issueField.parent('.md-input-wrapper').find('.md-input-bar').removeClass('bottom-border error-color');
                    $issueField.removeClass('uk-form-danger');
                    $issueValid = true;
                }

                if (!$subjectValid || !$issueValid) return false;

                ticket = {
                    subject: adminInfoFormData['ticket-subject'],
                    issue: adminInfoFormData['ticket-issue']
                };
                advanceSlide();
                setTimeout(function () {
                    sendIssue();
                }, 1500);
            });

            $('a#privacyPolicyBtn').click(function () {
                if (isDoubleClicked($(this))) return;
                showPrivacyPolicy();
            });

            $('button#privacyPolicyBackBtn').click(function () {
                if (isDoubleClicked($(this))) return;
                var privacyPolicySlide = $('#privacyPolicySlide');
                if (privacyPolicySlide.length > 0) {
                    privacyPolicySlide.fadeOut(300, function () {
                        privacyPolicySlide.addClass('hide');
                        var userInfoSlide = $('#userInfoSlide');
                        userInfoSlide.removeClass('hide');
                        userInfoSlide.fadeIn(300, function () {
                            userInfoSlide.addClass('activeSlide');
                        });
                    });
                    activeSlide = 1;
                }
            });

            function showPrivacyPolicy() {
                var $active = $('.activeSlide');
                var privacyPolicySlide = $('#privacyPolicySlide');
                if (privacyPolicySlide.length > 0) {
                    $active.fadeOut(300, function () {
                        privacyPolicySlide.css({ display: 'none' }).removeClass('hide');
                        $(this).addClass('hide');
                        privacyPolicySlide.fadeIn(300, function () {});
                    });
                }
            }

            function showTicketCreated() {
                var $active = $('.activeSlide');
                var ticketCreatedSlide = $('#ticketCreatedSlide');
                if (ticketCreatedSlide.length > 0) {
                    $active.fadeOut(300, function () {
                        ticketCreatedSlide.css({ display: 'none' }).removeClass('hide');
                        $(this).addClass('hide').removeClass('activeSlide');
                        ticketCreatedSlide.fadeIn(300, function () {
                            ticketCreatedSlide.addClass('activeSlide');
                        });
                    });
                    activeSlide++;
                }
            }

            function sendIssue() {
                var d = {
                    user: userInfo,
                    ticket: ticket,
                    captcha: $('#captcha').val()
                };
                $.ajax({
                    method: 'POST',
                    url: '/api/v1/public/tickets/create',
                    data: JSON.stringify(d),
                    contentType: 'application/json',
                    success: function (response) {
                        if (!response.success) {
                            // keep existing silent path
                        } else {
                            $('span#spanFullname').text(userInfo.fullname);
                            refreshCreatedLead(ticket.subject);
                            $('strong#strongUsername').text(userInfo.email);
                            $('strong#strongPassword').text(response.userData.chancepass);
                            showTicketCreated();
                        }
                    },
                    error: function (err) {
                        console.error(err);
                    }
                });
            }

            function validateEmail(email) {
                var mailFormat = /^\w+([.-]\w+)*@\w+([.-]\w+)*(\.\w+)+$/;
                return email.match(mailFormat);
            }

            $.fn.serializeObject = function () {
                var obj = {};
                $.each(this.serializeArray(), function (i, o) {
                    var n = o.name,
                        v = o.value;
                    obj[n] = obj[n] === undefined ? v : $.isArray(obj[n]) ? obj[n].concat(v) : [obj[n], v];
                });
                return obj;
            };
        });
    });
</script>
</body>
</html>
