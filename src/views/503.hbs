<!DOCTYPE html>
<html>
<head>
    <title>HelpDesk At-Once-AI · 503</title>
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link rel="stylesheet" href="/css/atonce-branding.css">
    <style type="text/css">
        html { overflow-x: hidden; }
        .wrapper {
            width: min(400px, 92vw);
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            margin-top: 2rem;
        }
        h2 {
            font-size: 6rem;
            font-weight: 300;
            margin: 0;
            color: #e2e8f0;
            font-family: "Segoe UI", system-ui, sans-serif;
        }
        h4 {
            font-size: 1.25rem;
            font-weight: 400;
            color: #94a3b8;
            font-family: "Segoe UI", system-ui, sans-serif;
        }
    </style>
</head>
<body class="atonce-public">
<div class="atonce-public-brand">
    <a href="/"><img src="/img/atonce-logo.png" alt="HelpDesk At-Once-AI" class="atonce-public-logo" /></a>
    <p class="login-product">HelpDesk At-Once-AI</p>
    <p class="login-version" id="atonce-version">…</p>
</div>
<div class="wrapper">
    <h2>503</h2>
    <h4>Service Unavailable</h4>
</div>
<script>
fetch('/version').then(function (r) { return r.json(); }).then(function (d) {
  var el = document.getElementById('atonce-version');
  if (el && d.versionLabel) el.textContent = d.versionLabel;
}).catch(function () {});
</script>
</body>
</html>
