{
  "name": "password-reset",
  "displayName": "Password Reset",
  "description": "Email notification sent when a user requests a password reset. (Forgot password notification)",
  "data": {
    "gjs-assets": "[]",
    "gjs-css": "body{margin:0;background:#0f172a;color:#e2e8f0;font-family:Segoe UI,Helvetica,Arial,sans-serif}.wrap{max-width:560px;margin:0 auto;padding:24px 16px}.card{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:24px}.logo{display:block;max-width:220px;height:auto;margin:0 auto 12px}.product{text-align:center;color:#67e8f9;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;margin:0 0 8px}.version{display:inline-block;padding:4px 10px;border-radius:999px;background:linear-gradient(135deg,#26c6da,#1565c0);color:#eff6ff;font-size:12px;font-weight:700;font-family:ui-monospace,Consolas,monospace}.center{text-align:center}h1{font-size:20px;font-weight:600;margin:0 0 12px;color:#e2e8f0}p{margin:0 0 12px;line-height:1.5;color:#cbd5e1;font-size:14px}.btn{display:inline-block;margin-top:8px;padding:12px 18px;border-radius:10px;background:linear-gradient(135deg,#26c6da,#1565c0);color:#eff6ff!important;text-decoration:none;font-weight:600;font-size:14px}.muted{color:#94a3b8;font-size:12px}",
    "gjs-html": "<div class=\"wrap\"><div class=\"card\"><div class=\"center\"><img class=\"logo\" src=\"{{base_url}}/img/atonce-logo.png\" alt=\"HelpDesk At-Once-AI\" /><p class=\"product\">HelpDesk At-Once-AI</p><p><span class=\"version\">{{versionLabel}}</span></p></div><h1>Password reset request</h1><p>Dear {{user.fullname}},</p><p>You requested a password reset for your HelpDesk At-Once-AI account: <strong>{{user.username}}</strong>.</p><p class=\"center\"><a class=\"btn\" href=\"{{base_url}}/resetpassword/{{user.resetPassHash}}\">Reset My Password</a></p><p class=\"muted\">If you did not request this, ignore this email and the link will expire on its own.</p></div></div>",
    "gjs-fullHtml": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width\"><style>body{margin:0;background:#0f172a;color:#e2e8f0;font-family:Segoe UI,Helvetica,Arial,sans-serif}.wrap{max-width:560px;margin:0 auto;padding:24px 16px}.card{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:24px}.logo{display:block;max-width:220px;height:auto;margin:0 auto 12px}.product{text-align:center;color:#67e8f9;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;margin:0 0 8px}.version{display:inline-block;padding:4px 10px;border-radius:999px;background:linear-gradient(135deg,#26c6da,#1565c0);color:#eff6ff;font-size:12px;font-weight:700;font-family:ui-monospace,Consolas,monospace}.center{text-align:center}h1{font-size:20px;font-weight:600;margin:0 0 12px;color:#e2e8f0}p{margin:0 0 12px;line-height:1.5;color:#cbd5e1;font-size:14px}.btn{display:inline-block;margin-top:8px;padding:12px 18px;border-radius:10px;background:linear-gradient(135deg,#26c6da,#1565c0);color:#eff6ff!important;text-decoration:none;font-weight:600;font-size:14px}.muted{color:#94a3b8;font-size:12px}</style></head><body><div class=\"wrap\"><div class=\"card\"><div class=\"center\"><img class=\"logo\" src=\"{{base_url}}/img/atonce-logo.png\" alt=\"HelpDesk At-Once-AI\" /><p class=\"product\">HelpDesk At-Once-AI</p><p><span class=\"version\">{{versionLabel}}</span></p></div><h1>Password reset request</h1><p>Dear {{user.fullname}},</p><p>You requested a password reset for your HelpDesk At-Once-AI account: <strong>{{user.username}}</strong>.</p><p class=\"center\"><a class=\"btn\" href=\"{{base_url}}/resetpassword/{{user.resetPassHash}}\">Reset My Password</a></p><p class=\"muted\">If you did not request this, ignore this email and the link will expire on its own.</p></div></div></body></html>"
  },
  "subject": "HelpDesk At-Once-AI · Password Reset · {{versionLabel}}"
}
