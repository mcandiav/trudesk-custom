# --- Runtime HelpDesk (servicio Easypanel: trudesk) ---
# No aplicar este bloque al servicio trudesk-base (ese va en Stop).
NODE_ENV=production
TRUDESK_DOCKER=true
USE_XFORWARDIP=true

# Mongo: host = $(PROJECT_NAME)_trudesk-db  (ej. n8n_trudesk-db)
# TD_MONGODB_URI=mongodb://mongo:PASSWORD@$(PROJECT_NAME)_trudesk-db:27017/?tls=false

# --- n8n: ticket.created webhook ---
# Dejar URL vacía = no llama a n8n (ticket se crea igual).
TD_N8N_TICKET_CREATED_WEBHOOK_URL=
TD_N8N_WEBHOOK_SECRET=
TD_N8N_WEBHOOK_TIMEOUT_MS=5000

# Runbook completo: docs/ops-easypanel-rebuild.md
